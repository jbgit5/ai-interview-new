{
  "name": "ai-interview-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/free-port.js 3000 && next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:local:setup": "bash ./setup-local-db.sh",
    "db:local:up": "docker compose -f docker-compose.local-db.yml up -d",
    "db:local:down": "docker compose -f docker-compose.local-db.yml down",
    "db:local:fix-auth-schema": "docker exec -i ai-interview-local-postgres psql -U postgres -d ai_interview -v ON_ERROR_STOP=1 < scripts/fix-better-auth-columns.sql",
    "db:local:migrate": "bash ./migrate-local.sh",
    "deploy:prod": "bash ./scripts/deploy-prod.sh",
    "test:live": "node --no-warnings --experimental-strip-types tests/live-engine.regression.mjs",
    "test:proctor": "node --no-warnings --experimental-strip-types tests/proctor.regression.mjs",
    "test:pipeline": "node --no-warnings --import ./tests/ts-resolve.mjs --experimental-strip-types tests/pipeline.regression.mjs",
    "test": "npm run test:pipeline && npm run test:live && npm run test:proctor && npm run test:screening",
    "test:screening": "node --no-warnings --import ./tests/ts-resolve.mjs --experimental-strip-types tests/cv-screening.regression.mjs",
    "test:screening:db": "node --no-warnings --import ./tests/ts-resolve.mjs --experimental-strip-types tests/cv-screening.db.mjs",
    "eval:screening": "node --no-warnings --import ./tests/ts-resolve.mjs --experimental-strip-types scripts/cv-eval/run.mjs"
  },
  "dependencies": {
    "@deepgram/sdk": "^3.13.0",
    "@huggingface/inference": "^4.13.15",
    "@livekit/components-react": "^2.9.20",
    "@mediapipe/tasks-vision": "^1.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@react-email/components": "^1.0.11",
    "@react-pdf/renderer": "^4.4.0",
    "@tanstack/react-table": "^8.20.5",
    "@types/pdf-parse": "^1.1.5",
    "better-auth": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "face-api.js": "^0.22.2",
    "framer-motion": "^11.15.0",
    "libphonenumber-js": "^1.13.15",
    "livekit-client": "^2.18.1",
    "livekit-server-sdk": "^2.15.1",
    "lucide-react": "^1.8.0",
    "mammoth": "^1.13.0",
    "next": "14.2.35",
    "openai": "^6.34.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "resend": "^6.10.0",
    "simli-client": "^3.1.0",
    "tailwind-merge": "^3.5.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/uuid": "^11.0.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
